import numpy as np
import matplotlib.pyplot as plt

x = np.array([1,2,3,4,5,6,7,8], dtype=float)
y = np.array([50,60,70,80,90,100,110,120], dtype=float)


split_index = int(0.75 * len(x))

x_train = x[:split_index]
y_train = y[:split_index]

x_test = x[split_index:]
y_test = y[split_index:]

print("Training data:", x_train)
print("Testing data:", x_test)

w = 0
b = 0
learning_rate = 0.01

for epoch in range(100):
    
    y_pred = w * x_train + b
    error = y_pred - y_train
    
    grad_w = np.mean(2 * error * x_train)
    grad_b = np.mean(2 * error)
    
    w = w - learning_rate * grad_w
    b = b - learning_rate * grad_b
	
y_test_pred = w * x_test + b

test_loss = np.mean((y_test_pred - y_test) ** 2)

print("Test Loss:", test_loss)

plt.scatter(x_train, y_train, label="Training data")
plt.scatter(x_test, y_test, label="Test data")

plt.plot(x, w*x + b, color="red", label="Model")

plt.legend()
plt.title("Train/Test Split Example")
plt.show()