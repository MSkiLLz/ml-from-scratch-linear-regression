import numpy as np

# Feature vector for one house
x = np.array([2000, 3, 2])  # sqft, bedrooms, bathrooms

print("Vector:", x)
print("Shape:", x.shape)

# Model weights
w = np.array([150, 10000, 8000])

prediction = np.dot(x, w)

print("Prediction (without bias):", prediction)

bias = 50000
prediction_with_bias = np.dot(x, w) + bias

print("Prediction (with bias):", prediction_with_bias)

def cosine_similarity(a, b):
    return np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b))

v1 = np.array([1, 0])
v2 = np.array([0, 1])
v3 = np.array([1, 1])

print("v1 vs v2:", cosine_similarity(v1, v2))  # near 0
print("v1 vs v3:", cosine_similarity(v1, v3))  # positive
