import numpy as np
import matplotlib.pyplot as plt

x = np.array([0, 1, 2, 3, 4], dtype=float)
y = np.array([40, 50, 60, 70, 80], dtype=float)

plt.scatter(x, y)
plt.xlabel("Hours studied")
plt.ylabel("Exam score")
plt.title("Training Data")
plt.show()

w = 0.0
b = 0.0
learning_rate = 0.01

for epoch in range(100):
    y_pred = w * x + b
    
    error = y_pred - y
    loss = np.mean(error ** 2)
    
    grad_w = np.mean(2 * error * x)
    grad_b = np.mean(2 * error)
    
    w = w - learning_rate * grad_w
    b = b - learning_rate * grad_b
    
    if epoch % 10 == 0:
        print(f"Epoch {epoch}: w={w:.4f}, b={b:.4f}, loss={loss:.4f}")
		
y_pred_final = w * x + b

plt.scatter(x, y, label="True data")
plt.plot(x, y_pred_final, label="Learned line", color="red")
plt.xlabel("Hours studied")
plt.ylabel("Exam score")
plt.title("Linear Regression with Weight and Bias")
plt.legend()
plt.show()

print(f"Final weight: {w:.4f}")
print(f"Final bias: {b:.4f}")

