import numpy as np
import matplotlib.pyplot as plt

# Feature vector (house example)
x = np.array([2000, 3, 2])

# Model weights
w = np.array([150, 10000, 8000])

prediction = np.dot(x, w)

print("Prediction (no bias):", prediction)

bias = 50000

prediction_with_bias = np.dot(x, w) + bias

print("Prediction (with bias):", prediction_with_bias)

manual = x[0]*w[0] + x[1]*w[1] + x[2]*w[2]

print("Manual:", manual)
print("NumPy:", np.dot(x, w))


# Example square footage values
x = np.linspace(0, 3000, 100)

# Different weights
w1 = 100
w2 = 150
w3 = 200

# Bias
b = 50000

# Predictions
y1 = w1 * x + b
y2 = w2 * x + b
y3 = w3 * x + b

plt.figure(figsize=(8,5))

plt.plot(x, y1, label="weight = 100")
plt.plot(x, y2, label="weight = 150")
plt.plot(x, y3, label="weight = 200")

plt.xlabel("Square Feet")
plt.ylabel("Predicted Price")
plt.title("How Weight Changes Predictions")
plt.legend()
plt.show()