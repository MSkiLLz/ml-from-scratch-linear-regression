import numpy as np

x = np.array([2000, 3, 2])
w = np.array([150, 10000, 8000])
prediction_no_bias = np.dot(x, w)

print("Prediction without bias:", prediction_no_bias)

bias = 50000

prediction_with_bias = np.dot(x, w) + bias

print("Prediction with bias:", prediction_with_bias)

X_simple = np.array([
    [2],
    [4],
    [6]
])

X_b = np.c_[np.ones((len(X_simple), 1)), X_simple]

print(X_b)

theta = np.array([
    [5],   # bias
    [3]    # weight
])

predictions = X_b @ theta

print(predictions)

#Why does adding a column of 1s represent bias?
# Treats the bias as just another weight