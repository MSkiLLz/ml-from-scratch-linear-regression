import numpy as np
import matplotlib.pyplot as plt

x = np.linspace(-5, 5, 100)

def sigmoid(x):
    return 1 / (1 + np.exp(-x))
	
def tanh(x):
    return np.tanh(x)
	
def relu(x):
    return np.maximum(0, x)

plt.plot(x, sigmoid(x), label="Sigmoid")
plt.plot(x, tanh(x), label="Tanh")
plt.plot(x, relu(x), label="ReLU")

plt.legend()
plt.title("Activation Functions")
plt.show()