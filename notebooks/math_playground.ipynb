import numpy as np
import matplotlib.pyplot as plt

# Dataset
x = np.array([0, 1, 2, 3, 4], dtype=float)
y = np.array([40, 50, 60, 70, 80], dtype=float)

# Parameters
w = 0.0
b = 0.0
learning_rate = 0.01

loss_history = []

# Training loop
for epoch in range(100):
    # Prediction
    y_pred = w * x + b

    # Error
    error = y_pred - y

    # Loss
    loss = np.mean(error ** 2)
    loss_history.append(loss)

    # Gradients
    grad_w = np.mean(2 * error * x)
    grad_b = np.mean(2 * error)

    # Parameter update
    w = w - learning_rate * grad_w
    b = b - learning_rate * grad_b

    if epoch % 10 == 0:
        print(f"Epoch {epoch}: w={w:.4f}, b={b:.4f}, loss={loss:.4f}")

print(f"\nFinal weight: {w:.4f}")
print(f"Final bias: {b:.4f}")

plt.plot(loss_history)
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.title("Loss Decreasing During Training")
plt.show()

y_pred_final = w * x + b

plt.scatter(x, y, label="True data")
plt.plot(x, y_pred_final, label="Learned line", color="red")
plt.xlabel("Hours studied")
plt.ylabel("Exam score")
plt.title("Final Trained Model")
plt.legend()
plt.show()

