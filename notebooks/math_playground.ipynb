import numpy as np
import matplotlib.pyplot as plt

def sigmoid(z):
    return 1 / (1 + np.exp(-z))
	
z = np.linspace(-10, 10, 100)
s = sigmoid(z)

plt.plot(z, s)
plt.title("Sigmoid Function")
plt.xlabel("z")
plt.ylabel("Probability")
plt.show()

z = np.array([-2, -1, 0, 1, 2])
probs = sigmoid(z)

print(probs)

def predict_class(prob):
    return 1 if prob >= 0.5 else 0
	
for p in probs:
    print(p, "→", predict_class(p))