import numpy as np
import matplotlib.pyplot as plt

sqft = np.array([1000, 1500, 2000, 2500, 3000], dtype=float)
bedrooms = np.array([1, 2, 3, 4, 5], dtype=float)

X = np.column_stack((sqft, bedrooms))
print(X)

X_scaled = (X - X.mean(axis=0)) / X.std(axis=0)

print("Scaled features:")
print(X_scaled)

plt.scatter(X[:, 0], X[:, 1])
plt.xlabel("sqft")
plt.ylabel("bedrooms")
plt.title("Raw Features")
plt.show()

plt.scatter(X_scaled[:, 0], X_scaled[:, 1])
plt.xlabel("scaled sqft")
plt.ylabel("scaled bedrooms")
plt.title("Scaled Features")
plt.show()

