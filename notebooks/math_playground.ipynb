import numpy as np

def neuron(x, w, b):
    z = np.dot(x, w) + b
    return z  # no activation yet
	
x = np.array([2, 3])
w = np.array([0.5, 0.2])
b = 1

print(neuron(x, w, b))

def relu(z):
    return np.maximum(0, z)

def neuron_with_activation(x, w, b):
    z = np.dot(x, w) + b
    return relu(z)

def simple_network(x):
    # Layer 1
    w1 = np.array([[0.5, 0.2],
                   [0.3, 0.8]])
    b1 = np.array([1, 1])

    z1 = np.dot(x, w1) + b1
    a1 = relu(z1)

    # Layer 2
    w2 = np.array([0.4, 0.6])
    b2 = 1

    z2 = np.dot(a1, w2) + b2
    return z2

x = np.array([2, 3])
print(simple_network(x))