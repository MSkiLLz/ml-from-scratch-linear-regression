import numpy as np

y_true = np.array([300, 250, 280, 320])
y_pred = np.array([290, 260, 275, 315])

mse = np.mean((y_true - y_pred)**2)

print("MSE:", mse)

mae = np.mean(np.abs(y_true - y_pred))

print("MAE:", mae)

ss_res = np.sum((y_true - y_pred)**2)
ss_tot = np.sum((y_true - np.mean(y_true))**2)

r2 = 1 - (ss_res / ss_tot)

print("R²:", r2)

#Why might MSE be misleading sometimes?
#Why is MAE easier to interpret?
#What does R² = 0 mean?

#Key ideas:

#MSE exaggerates large errors

#MAE shows average mistake size

#R² = 0 means model is no better than guessing mean