import numpy as np
import matplotlib.pyplot as plt

x = np.array([1,2,3,4])
y = np.array([50,60,70,80])

w = 0
learning_rate = 0.01

for epoch in range(50):

    y_pred = w * x
    
    error = y_pred - y
    
    loss = np.mean(error**2)
    
    gradient = np.mean(2 * error * x)
    
    w = w - learning_rate * gradient
    
    print("Epoch:", epoch, "Weight:", w, "Loss:", loss)
	
y_pred = w * x

plt.scatter(x,y)
plt.plot(x,y_pred,color="red")

plt.xlabel("Hours studied")
plt.ylabel("Score")
plt.title("Model Fit")
plt.show()

#Why weight moved correctly

#Because the gradient indicated the direction that reduces loss.

#Role of the loss function

#It measures prediction error and creates the surface the model optimizes.

#If learning rate is too large

#Training becomes unstable and the model may never converge.