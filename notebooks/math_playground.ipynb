import numpy as np

#dataset
X = np.array([
    [2000, 3, 2],
    [1500, 2, 1],
    [1800, 3, 2]
])

#weights
W = np.array([
    [150],
    [10000],
    [8000]
])

#Bias
b = 50000

#Linear model
Z = X @ W + b

print("Linear predictions:\n", Z)

#Activation Function
def relu(z):
    return np.maximum(0, z)

A = relu(Z)

print("Activated output:\n", A)

#What operation appears in almost every ML model?
# Matrix multiplication

#Why are GPUs essential for deep learning?
#They accelerate matrix operations.

#What makes neural networks more powerful than linear models?
#Activation functions introduce non-linearity.