import numpy as np
import matplotlib.pyplot as plt

#Define Weight Values
w = np.linspace(-10, 10, 100)

#Define Loss Function
loss = w**2

#Plot loss curve
plt.plot(w, loss)
plt.xlabel("Weight")
plt.ylabel("Loss")
plt.title("Loss Function")
plt.show()

def gradient(w):
    return 2*w
	
print(gradient(5))
print(gradient(-5))