import numpy as np
import matplotlib.pyplot as plt

np.random.seed(42)

x = np.linspace(0, 10, 20)
y = 2*x + 5 + np.random.randn(20) * 2

# Underfitting: constant model
y_underfit = np.full_like(x, np.mean(y))

plt.scatter(x, y, label="Data")
plt.plot(x, y_underfit, label="Underfit (too simple)", color="red")
plt.legend()
plt.title("Underfitting")
plt.show()

coeffs = np.polyfit(x, y, 1)
y_good = np.polyval(coeffs, x)

plt.scatter(x, y, label="Data")
plt.plot(x, y_good, label="Good Fit", color="green")
plt.legend()
plt.title("Good Fit")
plt.show()

coeffs_high = np.polyfit(x, y, 10)
y_overfit = np.polyval(coeffs_high, x)

plt.scatter(x, y, label="Data")
plt.plot(x, y_overfit, label="Overfit (too complex)", color="purple")
plt.legend()
plt.title("Overfitting")
plt.show()