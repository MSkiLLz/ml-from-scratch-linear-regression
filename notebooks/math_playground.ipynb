import numpy as np

x = np.array([2, 3])

W1 = np.array([[0.5, 0.2],
               [0.3, 0.8]])
b1 = np.array([1, 1])

z1 = np.dot(x, W1) + b1
print("z1:", z1)

def relu(z):
    return np.maximum(0, z)

a1 = relu(z1)
print("a1:", a1)

W2 = np.array([0.4, 0.6])
b2 = 1

z2 = np.dot(a1, W2) + b2
print("Output:", z2)

def forward_pass(x):
    W1 = np.array([[0.5, 0.2],
                   [0.3, 0.8]])
    b1 = np.array([1, 1])

    W2 = np.array([0.4, 0.6])
    b2 = 1

    z1 = np.dot(x, W1) + b1
    a1 = np.maximum(0, z1)

    z2 = np.dot(a1, W2) + b2

    return z2
	
print(forward_pass(np.array([2, 3])))