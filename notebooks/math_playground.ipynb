import numpy as np

# Inputs (2 features)
X = np.array([
    [1, 2],
    [2, 3],
    [3, 4],
    [5, 6]
])

# Targets
y = np.array([0, 0, 1, 1])

np.random.seed(42)

W1 = np.random.randn(2, 2)
b1 = np.zeros(2)

W2 = np.random.randn(2, 1)
b2 = 0

def relu(x):
    return np.maximum(0, x)

def sigmoid(x):
    return 1 / (1 + np.exp(-x))

def forward(X):
    z1 = np.dot(X, W1) + b1
    a1 = relu(z1)

    z2 = np.dot(a1, W2) + b2
    a2 = sigmoid(z2)

    return z1, a1, z2, a2
	
learning_rate = 0.01

for epoch in range(100):

    # Forward pass (reuse from yesterday)
	z1, a1, z2, a2 = forward(X)

	# Output layer error
	dz2 = a2.flatten() - y

	# Gradients for W2
	dW2 = np.dot(a1.T, dz2.reshape(-1,1))
	db2 = np.mean(dz2)

	# Backprop into hidden layer
	da1 = np.dot(dz2.reshape(-1,1), W2.T)

	# ReLU derivative
	dz1 = da1 * (z1 > 0)

	# Gradients for W1
	dW1 = np.dot(X.T, dz1)
	db1 = np.mean(dz1, axis=0)
	
	W2 -= learning_rate * dW2
	b2 -= learning_rate * db2

	W1 -= learning_rate * dW1
	b1 -= learning_rate * db1

		
_, _, _, preds = forward(X)
print(preds)