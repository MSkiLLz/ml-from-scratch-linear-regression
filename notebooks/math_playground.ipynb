import numpy as np

def forward(x, w, b):
    return np.dot(x, w) + b
	
x = np.array([2, 3])
w = np.array([0.5, 0.2])
b = 1

y_pred = forward(x, w, b)
print("Prediction:", y_pred)

y_true = 10

loss = (y_pred - y_true)**2
print("Loss:", loss)

grad_w = 2 * (y_pred - y_true) * x
grad_b = 2 * (y_pred - y_true)

learning_rate = 0.01

w = w - learning_rate * grad_w
b = b - learning_rate * grad_b

print("Updated weights:", w)
print("Updated bias:", b)

#What is the purpose of the gradient?
#Why do we subtract the gradient?
#What does the learning rate control?

#Key ideas:

#gradient = direction to reduce loss
#subtraction moves toward minimum
#learning rate = step size