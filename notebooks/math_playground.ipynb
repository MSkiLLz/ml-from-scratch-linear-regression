import numpy as np

def cross_entropy(y_true, p):
    return -(y_true*np.log(p) + (1-y_true)*np.log(1-p))
	
# Good prediction
print("Good:", cross_entropy(1, 0.9))

# Bad prediction
print("Bad:", cross_entropy(1, 0.1))

p = np.linspace(0.01, 0.99, 100)

loss_1 = -np.log(p)        # when y = 1
loss_0 = -np.log(1 - p)    # when y = 0

import matplotlib.pyplot as plt

plt.plot(p, loss_1, label="y=1")
plt.plot(p, loss_0, label="y=0")

plt.xlabel("Predicted Probability")
plt.ylabel("Loss")
plt.title("Cross-Entropy Loss")
plt.legend()
plt.show()