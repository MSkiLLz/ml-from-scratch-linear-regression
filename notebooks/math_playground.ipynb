import numpy as np
import matplotlib.pyplot as plt

#initialize weight
w = 8

#Set Learning Rate
learning_rate = 0.1

#Gradient Function
def gradient(w):
    return 2*w
	
#Training loop

for step in range(10):
    
    grad = gradient(w)
    
    w = w - learning_rate * grad
    
    print("Step:", step, "Weight:", w)
	
w_values = []
w = 8

for step in range(20):
    w_values.append(w)
    grad = gradient(w)
    w = w - learning_rate * grad

plt.plot(w_values)
plt.title("Weight Converging Toward Minimum")
plt.xlabel("Iteration")
plt.ylabel("Weight")
plt.show()